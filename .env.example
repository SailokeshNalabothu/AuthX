# ========================================================
# 🛡️ AuthX Server Environment Configuration
# ========================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (Local or MongoDB Atlas Cloud)
# For local MongoDB: mongodb://127.0.0.1:27017/authx
# For MongoDB Atlas (Render / Production): mongodb+srv://<username>:<password>@cluster0.mongodb.net/authx?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/authx

# JWT Security Secrets (Use random 32+ character strings in production)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_change_in_production
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_SECRET=your_fallback_jwt_secret

# Email Service (Nodemailer - Gmail App Password or SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend Client URL (For redirects after Google SSO)
# Local: http://localhost:3000
# Production: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:3000
